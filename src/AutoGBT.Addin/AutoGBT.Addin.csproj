<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>AutoGBT.Addin</RootNamespace>
    <AssemblyName>AutoGBT.Addin</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <RegisterForComInterop>false</RegisterForComInterop>
    <UseWindowsForms>true</UseWindowsForms>
    <SolidWorksApiPath Condition="'$(SolidWorksApiPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoGBT.Core\AutoGBT.Core.csproj" />
    <ProjectReference Include="..\AutoGBT.UI\AutoGBT.UI.csproj" />
    <ProjectReference Include="..\AutoGBT.SolidWorks\AutoGBT.SolidWorks.csproj"
                      Condition="Exists('$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll')" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll')">
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <Target Name="RequireSolidWorksApi" BeforeTargets="CoreCompile"
          Condition="!Exists('$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll')">
    <Error Text="SolidWorks API yok — Addin atlanmali. Solution Explorer'da AutoGBT.Desktop'a sag tik - Set as Startup Project, sonra F5." />
  </Target>
</Project>
