<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>AutoGBT.SolidWorks</RootNamespace>
    <AssemblyName>AutoGBT.SolidWorks</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <SolidWorksApiPath Condition="'$(SolidWorksApiPath)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoGBT.Core\AutoGBT.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll')">
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiPath)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireSolidWorksApi" BeforeTargets="CoreCompile"
          Condition="!Exists('$(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll')">
    <Error Text="SolidWorks API DLL bulunamadi: $(SolidWorksApiPath)\SolidWorks.Interop.sldworks.dll. Masaustu icin AutoGBT.Desktop projesini derleyin (F5). Eklenti icin SolidWorks kurulu olmali." />
  </Target>
</Project>
